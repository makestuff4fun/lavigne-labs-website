# Deploy credentials for scripts/deploy.sh — FTPS upload to lavignelabs.com.
#
# This file is a TEMPLATE. The real one lives OUTSIDE the repo so a secret can
# never be committed:
#
#   mkdir -p ~/.config/lavigne-labs
#   install -m 600 /dev/null ~/.config/lavigne-labs/deploy.env
#   # then paste the lines below into it and fill in the values
#
# deploy.sh refuses to run unless that file is mode 0600.
#
# ── VERIFIED VALUES FOR THE LIVE HOST (2026-07-29, tested from tunnel-bear) ──
# Fill DEPLOY_PASS from cPanel and the rest is known-good:
#   DEPLOY_HOST=lavignelabs.com
#   DEPLOY_USER=brian@lavignelabs.com
#   DEPLOY_PASS='<from cPanel → FTP Accounts>'
#   DEPLOY_REMOTE_DIR=.        # account logs into the docroot; NO public_html subdir
#   DEPLOY_SSL_VERIFY=false    # shared-host FTPS cert has no lavignelabs.com SAN
#   DEPLOY_PROTECT='.well-known cgi-bin .htaccess .ftpquota'
# And RUN deploy.sh FROM tunnel-bear — FTP is blocked from blue.
# ────────────────────────────────────────────────────────────────────────────

# cPanel FTP hostname. NOT a URL — no ftp:// prefix. For this host: lavignelabs.com
DEPLOY_HOST=

# cPanel FTP username. For this host: brian@lavignelabs.com
DEPLOY_USER=

# That FTP user's password (quote it — the real one contains shell metacharacters).
DEPLOY_PASS=

# --- optional ---------------------------------------------------------------

# Document root to mirror into, relative to the FTP login directory.
# THIS host's account logs straight into the docroot, so use ".". Setting
# public_html here would nest the whole site at public_html/public_html.
#DEPLOY_REMOTE_DIR=.

# Space-separated paths never deleted from the server, even though the mirror
# runs with --delete. Defaults to ".well-known cgi-bin". On this host also keep
# .htaccess (cPanel's PHP handler) and .ftpquota (server-managed — deleting it
# errors the mirror). .well-known holds Let's Encrypt renewal challenges, so
# deleting it breaks HTTPS at the next renewal. Set to empty for a pure mirror.
#DEPLOY_PROTECT='.well-known cgi-bin .htaccess .ftpquota'

# Set to false when the host's FTPS cert doesn't match the hostname. This host
# presents the shared-server cert (no lavignelabs.com SAN), so it must be false.
# Data is still TLS-encrypted; only hostname verification is skipped.
#DEPLOY_SSL_VERIFY=false

# Base URL used for the post-deploy verification check.
#DEPLOY_VERIFY_URL=https://lavignelabs.com
