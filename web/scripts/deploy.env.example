# Deploy credentials for scripts/deploy.sh — FTPS upload to lavignelabs.com.
#
# This file is a TEMPLATE. The real one lives OUTSIDE the repo so a secret can
# never be committed:
#
#   mkdir -p ~/.config/lavigne-labs
#   install -m 600 /dev/null ~/.config/lavigne-labs/deploy.env
#   # then paste the lines below into it and fill in the values
#
# deploy.sh refuses to run unless that file is mode 0600.

# cPanel FTP hostname. Usually ftp.lavignelabs.com or the server hostname your
# host gave you. NOT a URL — no ftp:// prefix.
DEPLOY_HOST=

# cPanel FTP username. Often the cPanel account name, or a dedicated FTP user
# you create under cPanel → FTP Accounts (recommended: scope it to public_html).
DEPLOY_USER=

# That FTP user's password.
DEPLOY_PASS=

# --- optional ---------------------------------------------------------------

# Document root to mirror into, relative to the FTP login directory.
# A cPanel FTP account scoped to public_html may already land there — in that
# case set this to "." or the upload will nest at public_html/public_html.
#DEPLOY_REMOTE_DIR=public_html

# Space-separated paths never deleted from the server, even though the mirror
# runs with --delete. Defaults to ".well-known cgi-bin" — .well-known is where
# Let's Encrypt writes renewal challenges, so deleting it breaks HTTPS at the
# next renewal. Set to empty for a literal pure mirror.
#DEPLOY_PROTECT=".well-known cgi-bin"

# Set to false only if the host's FTPS certificate is self-signed and lftp
# rejects it. Leave true whenever possible.
#DEPLOY_SSL_VERIFY=true

# Base URL used for the post-deploy verification check.
#DEPLOY_VERIFY_URL=https://lavignelabs.com
