# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# NOTE: the site lives in web/, so build/dependency patterns below are
# deliberately unanchored — they match web/node_modules, web/out, etc.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# deployment artifacts (regenerated by the build/export scripts — see docs/DEPLOYMENT.md)
dist-games/
*.zip
*:Zone.Identifier

# agent/editor session files
/.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
